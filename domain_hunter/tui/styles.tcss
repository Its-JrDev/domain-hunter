/* Estilos TCSS Modernos para Domain Hunter (Estilo OpenCode) */

Screen {
    layout: vertical;
    background: #0d1117;
    color: #e6edf3;
}

/* Header & Top Bar */
Header {
    background: #161b22;
    color: #58a6ff;
    border-bottom: solid #30363d;
}

#top-bar {
    height: auto;
    padding: 1 1 0 1;
    background: #0d1117;
}

#search-box {
    layout: horizontal;
    height: 3;
    align: left middle;
}

#search-input {
    width: 1fr;
    height: 3;
    border: round #388bfd;
    background: #161b22;
    color: #ffffff;
    padding: 0 1;
    margin-right: 1;
}

#search-input:focus {
    border: round #58a6ff;
}

.action-btn {
    height: 3;
    border: none;
    min-width: 11;
    background: #21262d;
    color: #c9d1d9;
    margin-right: 1;
    text-style: bold;
}

.action-btn:hover {
    background: #30363d;
    color: #ffffff;
}

.btn-primary {
    background: #1f6feb;
    color: #ffffff;
}

.btn-primary:hover {
    background: #388bfd;
}

/* Contenedor principal de 3 columnas */
#main-split {
    layout: horizontal;
    height: 1fr;
    padding: 1;
}

/* Paneles individuales */
.split-pane {
    height: 100%;
    background: #161b22;
    border: round #30363d;
    padding: 0;
}

.split-pane:focus-within {
    border: round #388bfd;
}

.pane-header {
    height: 2;
    padding: 0 1;
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
    border-bottom: solid #30363d;
}

/* Panel Izquierdo: Sesiones */
#sidebar-pane {
    width: 26;
    margin-right: 1;
}

#sessions-list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#sessions-list > .option-list--option-highlighted {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

#sidebar-footer {
    height: 3;
    padding: 0 1;
    border-top: solid #30363d;
    align: center middle;
}

/* Panel Central: Resultados */
#results-pane {
    width: 1fr;
    margin-right: 1;
}

#results-table {
    height: 100%;
    background: transparent;
    border: none;
}

#results-table > .datatable--header {
    background: #21262d;
    color: #8b949e;
    text-style: bold;
}

#results-table > .datatable--cursor {
    background: #1f6feb 35%;
    color: #ffffff;
    text-style: bold;
}

/* Panel Derecho: Inspector en vivo */
#inspector-pane {
    width: 38;
}

#inspector-content {
    height: 1fr;
    padding: 1;
}

.inspector-title {
    text-style: bold;
    color: #ffffff;
    margin-bottom: 1;
}

.inspector-badge {
    padding: 0 1;
    margin-bottom: 1;
    height: 1;
    text-style: bold;
}

.badge-available {
    background: #238636;
    color: #ffffff;
}

.badge-taken {
    background: #da3633;
    color: #ffffff;
}

.badge-querying {
    background: #d29922;
    color: #000000;
}

.inspector-section {
    margin-top: 1;
    margin-bottom: 0;
    color: #8b949e;
    text-style: bold;
}

.inspector-field {
    color: #c9d1d9;
    margin-bottom: 0;
}

.inspector-links {
    margin-top: 1;
    padding: 1;
    background: #0d1117;
    border: solid #30363d;
}

/* Barra inferior (Pills / Controles) */
#bottom-bar {
    layout: horizontal;
    height: 3;
    padding: 0 1;
    background: #161b22;
    border-top: solid #30363d;
    align: left middle;
}

.pill-btn {
    height: 2;
    margin-right: 1;
    padding: 0 1;
    background: #21262d;
    color: #c9d1d9;
    border: none;
    text-style: bold;
}

.pill-btn:hover {
    background: #30363d;
    color: #ffffff;
}

.pill-active {
    background: #238636;
    color: #ffffff;
}

#status-stats {
    width: 1fr;
    text-align: right;
    color: #8b949e;
    padding-right: 1;
}

/* Modales */
.modal-dialog {
    width: 65;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: #161b22;
    border: round #388bfd;
}

.tld-grid-container {
    grid-size: 4;
    grid-gutter: 0 1;
    height: auto;
    margin: 1 0;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
    height: auto;
}

.modal-btn {
    margin-left: 1;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #58a6ff;
    margin-bottom: 1;
    border-bottom: solid #30363d;
    padding-bottom: 1;
}
